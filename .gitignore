# Docker
docker-compose.override.yml
# NOT .dockerignore. It was listed here, almost certainly copied in from a
# boilerplate file, and it is wrong: .dockerignore decides what goes into the
# image, so it has to be versioned like the Dockerfile beside it. Without
# backend/.dockerignore in git, a fresh clone that creates backend/venv ships 2.1 GB
# of Windows wheels to the Docker daemon on every build. Found in D01.

# Temporary files
tmp/
temp/
*.tmp
*.temp
.cache/

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb

# Backup files
*.bak
*.backup
*~
config.bat
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat

# Generated by scripts/seed.sh --sql: numbered SQL files to paste by hand.
# Regenerated on demand and carrying timestamps relative to when they were made,
# so never worth committing.
.seed-sql/
