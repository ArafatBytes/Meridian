frontend/.expo-shared/
frontend/dist/
frontend/build/
frontend/web-build/
frontend/npm-debug.*
frontend/yarn-error.*
frontend/.DS_Store

# Node modules
node_modules/

# NOTE: package-lock.json and yarn.lock were ignored here. For an application
# (as opposed to a published library) that is wrong: without a committed
# lockfile the two of us resolve different dependency trees, `npm ci` cannot
# run, and CI tests a tree nobody has. It is also what kept defect 19 open --
# the file existed on disk and could not be added. Same shape as the bare
# `lib/` rule that swallowed frontend/src/lib (defect 1): a pattern copied
# from a generic template, matching more than it meant to.

