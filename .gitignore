# Meridian - Root .gitignore

# Environment files
#
# The original rule here was ONLY `.env.*.local`, which left a plain `.env`
# fully trackable. backend/.env holds the Supabase service-role key, the
# database password and the Anthropic API key — a single `git add -A` would
# have published all three. Found and fixed in S01.
#
# `!*.env.example` keeps the committed templates visible.

# OS Files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
.Spotlight-V100
.Trashes

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
server.log
celery.log

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# Anchored to the repo root on purpose: a bare `lib/` also matches
# frontend/src/lib/, which silently excluded the Supabase client from git and
# made the repo unbuildable from a clean clone. Do not un-anchor these.
/lib/
/backend/lib/
/lib64/
/backend/lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environment
backend/venv/
backend/env/
backend/ENV/
backend/env.bak/
backend/venv.bak/
venv/
env/
ENV/
env.bak/
venv.bak/

