# ============================================================================
# Meridian — frontend environment
# ============================================================================
# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
# Only EXPO_PUBLIC_* variables reach the app bundle. They are inlined at build
# time, so after changing any of them you must restart Metro with a cleared
# cache:
#
#     npx expo start --clear
#
# Anything here ships inside the app and is readable by anyone who downloads
# it. Never put a service-role key or any other secret in this file — the
# Supabase anon key is safe only because Row Level Security is what actually
# guards the data (see backend/migrations/supabase/SCHEMA.sql §7).
# ============================================================================

# From Supabase dashboard → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Meridian backend (FastAPI). Used for AI analysis, routing, SOS.
# Not `localhost` — a phone or emulator resolves that to itself:
#   Physical device     → your machine's LAN IP, e.g. http://192.168.0.103:8000/api/v1
#   Android emulator    → http://10.0.2.2:8000/api/v1
#   iOS simulator       → http://localhost:8000/api/v1
#
# NOTE: as of S01 the app still reads API_BASE_URL from
# src/constants/app.constants.ts, where it is hardcoded. This variable becomes
# live when that constant is wired up in S07.
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.103:8000/api/v1
