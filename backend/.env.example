# Application Settings
APP_NAME=Meridian
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=True

# Database Configuration
POSTGRES_USER=Meridian_user
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=Meridian_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# PostGIS Extension (automatically enabled)
ENABLE_POSTGIS=True

# ---------------------------------------------------------------------------
# Supabase  (added S01)
# ---------------------------------------------------------------------------
# Full setup guide: backend/migrations/supabase/README.md
#
# When pointing at Supabase, DATABASE_URL above must be the Supabase connection
# string with the asyncpg driver, which overrides the POSTGRES_* values:
#
#   DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
#
# Two traps, both of which produce confusing runtime errors:
#   * Port 5432 (session pooler), NOT 6543. Port 6543 is PgBouncer in
#     transaction mode and breaks asyncpg's prepared-statement cache.
#   * `postgresql+asyncpg://`, not `postgresql://`. Supabase hands you the
#     latter and the async engine will not start without the driver suffix.
SUPABASE_URL=https://your-project-ref.supabase.co

# Server-side only. Bypasses Row Level Security — never ship this to the app.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# Celery Configuration
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/0

# JWT Authentication
#
# ⚠️  When using Supabase, this MUST be the Supabase JWT secret
# (Settings → API → JWT Settings) — the app sends Supabase-issued tokens and
# app/core/security.py validates them with this shared HS256 secret.
#
# New Supabase projects default to asymmetric (ECC/RSA) signing keys, for which
# HS256 validation cannot work: every authenticated backend call returns
# 401. If your project has no legacy HS256 secret, pull ADR 0002 (S02) forward
# and switch to JWKS verification instead of working around it.
JWT_SECRET_KEY=your-supabase-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5000
ALLOWED_METHODS=*
ALLOWED_HEADERS=*

# SMS Gateway - CloudWaveBD
CLOUDWAVEBD_API_KEY=your-cloudwavebd-api-key
CLOUDWAVEBD_SENDER_ID=Meridian
CLOUDWAVEBD_API_URL=https://api.cloudwavebd.com/sms/send

# Twilio (Backup SMS)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Firebase Cloud Messaging
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# AWS S3 / Cloud Storage
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=Meridian-media
S3_VIDEO_BUCKET=Meridian-sos-videos

# Google Maps API (Optional)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Google Cloud AI Services
GOOGLE_CLOUD_PROJECT_ID=your-google-cloud-project-id
GOOGLE_CLOUD_CREDENTIALS_PATH=./google-cloud-credentials.json
GOOGLE_CLOUD_REGION=us-central1

# Speech-to-Text Settings
SPEECH_RECOGNITION_LANGUAGE=en-US
SPEECH_MAX_DURATION_SECONDS=30
SPEECH_SAMPLE_RATE=16000

# OSRM Routing Server
OSRM_BASE_URL=http://localhost:5000

# Crime Score Calculation
CRIME_SCORE_UPDATE_INTERVAL=1800  # 30 minutes in seconds
CRIME_ZONE_GRID_SIZE=500  # meters
CRIME_TIME_DECAY_DAYS=90  # How many days to consider for scoring

# Geofencing
DANGER_ZONE_THRESHOLD=75  # Crime score above this triggers alert
LOCATION_UPDATE_INTERVAL=60  # seconds

# SOS Settings
SOS_VIDEO_MAX_DURATION=300
# 25 MB: must match app/core/config.py, and stay under the mail provider's
# attachment limit, because the video is emailed as an attachment.
SOS_VIDEO_MAX_SIZE_MB=25
EMERGENCY_RESPONSE_RADIUS_KM=10

# ---------------------------------------------------------------------------
# Email (SMTP)  —  REQUIRED FOR SOS  (added S01)
# ---------------------------------------------------------------------------
# These were missing from this template even though app/services/email_service.py
# cannot send without them. SOS is email-only today: with these blank, an SOS
# trigger reports success to the user and silently delivers nothing.
#
# Gmail needs an App Password (not your account password) with 2FA enabled.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
FROM_EMAIL=your-email@gmail.com

# Set false until police_stations.csv has real contact data — all 606 rows
# currently share one placeholder address. See Defect 17 / S05.
POLICE_ROUTING_ENABLED=false

# ---------------------------------------------------------------------------
# Anthropic  (added S01; first used in S04)
# ---------------------------------------------------------------------------
# Powers the agent layer: incident extraction, Bangla landmark geocoding,
# General Diary drafting. See IMPLEMENTATION_PLAN.md §6.4.
# Leave blank until S04 — nothing reads it before then.
ANTHROPIC_API_KEY=
LLM_MODEL_JUDGMENT=claude-opus-5-5
LLM_MODEL_BULK=claude-sonnet-5-5

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Monitoring
SENTRY_DSN=your-sentry-dsn-for-error-tracking
