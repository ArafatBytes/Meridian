# ============================================================================
# Email (SMTP)  -- REQUIRED FOR SOS
# ============================================================================
# email_service.py is the ONLY alert channel SOS has. With SMTP_USER /
# SMTP_PASSWORD / FROM_EMAIL empty, an SOS trigger reports success in the app
# and silently delivers nothing.
#
# --- Gmail (what the defaults assume) --------------------------------------
# 1. Enable 2-Step Verification on the Google account:
#      myaccount.google.com/security
# 2. Create an App Password (NOT your account password):
#      myaccount.google.com/apppasswords
#      Pick "Mail" + "Other (Custom name)" -> "Meridian"
# 3. Google shows a 16-character code like: abcd efgh ijkl mnop
#    Paste it below WITHOUT the spaces: abcdefghijklmnop
#
# SMTP_USER and FROM_EMAIL are normally the same Gmail address. FROM_EMAIL is
# what recipients see as the sender; Gmail rejects a FROM that is not an
# address the authenticated account is allowed to send as.
# ----------------------------------------------------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=dummytest801@gmail.com
SMTP_PASSWORD=drjqqgbtwjkxfgvm
FROM_EMAIL=dummytest801@gmail.com

# Whether SOS also emails nearby police stations.
#
# KEEP THIS false. All 606 rows in police_stations.csv share one placeholder
# address (noorlabib@iut-dhaka.edu), so enabling it means every SOS test emails
# a stranger. Turn it on when the CSV holds real contacts (defect 17, S05).
POLICE_ROUTING_ENABLED=false
# ---- LLM: named per FEATURE, not globally ------------------------------------
# A feature is one job that needs a model: GEO (place resolution, D03), and later
# EXTRACT (D04), VISION (D07), CASEWORK (D08). Each declares its own chain and its
# own keys. Two reasons the split is worth the longer names:
#
#   Different jobs want different models. openai/gpt-oss-120b is a sound fallback
#   for place names and is NOT multimodal, so the same chain would simply fail for
#   D07's images - behind a name that gave no hint of it.
#
#   Keys per feature means isolated quota. On this project multiple keys belong to
#   different accounts, so their limits are independent (Gemini's apply per
#   project, Groq's per organization). D04's ingestion loop therefore cannot
#   exhaust the daily budget D03's search box needs.
#
# Chain format: `provider:model` pairs, comma separated, tried left to right.
# Providers: gemini, groq. Keys are discovered from EVERY variable named
# <PROVIDER>_KEY_<FEATURE>_*, so adding _TWO widens the quota with no code change.
# A feature falls back to NO other feature's keys - that coupling is the point.
#
# This GEO default was measured, not guessed: a six-case probe plus a 53-case eval
# on 2026-10-07. gemini-3.5-flash-lite answered 6/6 and refused both fabricated
# places. gpt-oss-120b is second because it is a DIFFERENT provider - a
# same-provider fallback shares the rate limit and fails at the same moment as the
# primary. gemini-3.1-flash-lite is deliberately absent despite scoring 5/6: it
# invented coordinates for a place that does not exist, twice, at 0.95 confidence.
LLM_CHAIN_GEO=gemini:gemini-3.5-flash-lite,groq:openai/gpt-oss-120b

# One key per line, per account. Add _TWO, _THREE as you get them.
GEMINI_KEY_GEO_ONE=AQ.Ab8RN6J8vt_MG_qrPCLuj-WQKtMbG8p2ZQxHtiM0Pln6lkyucQ
GROQ_KEY_GEO_ONE=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

